<section>
    <h2 class="h3 mb-3">Skills</h2>
    <ul class="list-unstyled d-flex flex-wrap gap-2 mb-0">
        @foreach (var skill in Skills)
        {
            <li><span class="badge rounded-pill bg-primary">@skill</span></li>
        }
    </ul>
</section>

@code {
    private readonly string[] Skills = ["C#", "Blazor", "ASP.NET Core", "SQLite"];
}
