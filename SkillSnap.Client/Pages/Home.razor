@page "/"

<PageTitle>Home</PageTitle>

<section class="home-hero">
    <span class="eyebrow">Your next opportunity starts here</span>
    <h1>Put your work in the spotlight.</h1>
    <p>
        Discover hands-on projects, grow your skills, and build a portfolio that shows what you can do.
    </p>
    <NavLink class="btn btn-primary d-inline-flex align-items-center gap-2 px-4" href="project-listing">
        Explore projects
        <AppIcon Name="arrow" Size="18" />
    </NavLink>
</section>

<section class="row g-3 home-features" aria-label="SkillSnap features">
    <div class="col-md-4">
        <article class="card feature-card">
            <span class="feature-icon"><AppIcon Name="compass" Size="21" /></span>
            <h2>Find your next project</h2>
            <p class="mb-0">Browse opportunities and enroll in projects that match your goals.</p>
        </article>
    </div>
    <div class="col-md-4">
        <article class="card feature-card">
            <span class="feature-icon"><AppIcon Name="skills" Size="21" /></span>
            <h2>Build practical skills</h2>
            <p class="mb-0">Learn by doing and keep moving forward with every project.</p>
        </article>
    </div>
    <div class="col-md-4">
        <article class="card feature-card">
            <span class="feature-icon"><AppIcon Name="folder" Size="21" /></span>
            <h2>Show your progress</h2>
            <p class="mb-0">Keep your project activity and achievements together in one place.</p>
        </article>
    </div>
</section>
